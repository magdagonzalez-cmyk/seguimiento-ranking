---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

const {
    title = "Ranking TP",
    description = "Sistema de seguimiento académico para estudiantes TP."
} = Astro.props;

const usuario = Astro.locals.usuario;
---

<!doctype html>
<html lang="es">
<head>
    <meta charset="UTF-8" />

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    />

    <meta
        name="description"
        content={description}
    />

    <title>{title}</title>
</head>

<body>

    <!-- HEADER -->
    <Header usuario={usuario} />

    <!-- CONTENIDO DE CADA PÁGINA -->
    <main>
        <slot />
    </main>

    <!-- FOOTER -->
    <Footer />

</body>
</html>