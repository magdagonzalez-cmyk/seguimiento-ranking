---
const {
    nombre,
    descripcion,
    icono = "📚"
} = Astro.props;
---

<article class="tarjeta-taller">

    <div class="icono-taller">
        {icono}
    </div>

    <div>

        <h3>
            {nombre}
        </h3>

        <p>
            {descripcion}
        </p>

    </div>

</article>