---
interface Props {
    usuario?: {
        rut: string;
        nombre: string;
        curso: string;
    };
}

const { usuario } = Astro.props;
---

<header class="header">
    <div class="header-contenido">

        <!-- LOGO -->
        <a href="/rankingtp" class="logo">
            TPRanking
        </a>

        <!-- NAVEGACIÓN -->
        <nav class="navegacion">

            <a href="/rankingtp">
                Inicio
            </a>

            <a href="/ranking">
                Ranking
            </a>

            <a href="/asignaturas">
                Asignaturas
            </a>

            <a href="/nosotros">
                Nosotros
            </a>

            <!-- MI INFORMACIÓN -->
            <a
                href="/mi-informacion"
                class="boton-mi-informacion"
            >
                🔒 Mi información
            </a>

            <!-- USUARIO CONECTADO -->
            {usuario && (
                <div class="usuario-conectado">

                    <span class="usuario-icono">
                        👤
                    </span>

                    <div class="usuario-datos">

                        <strong>
                            {usuario.nombre}
                        </strong>

                        <small>
                            {usuario.curso}
                        </small>

                    </div>

                </div>
            )}

            <!-- CERRAR SESIÓN -->
            <form
                action="/api/logout"
                method="POST"
                class="form-cerrar-sesion"
            >
                <button
                    type="submit"
                    class="boton-cerrar-sesion"
                >
                    ↪ Cerrar sesión
                </button>
            </form>

        </nav>

    </div>
</header>