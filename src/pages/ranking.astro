---
import Layout from "../layouts/Layout.astro";

const estudiantes = [
    {
        puesto: 1,
        nombre: "Estudiante Ejemplo 1",
        curso: "3.º medio TP",
        puntos: 950,
    },
    {
        puesto: 2,
        nombre: "Estudiante Ejemplo 2",
        curso: "4.º medio TP",
        puntos: 920,
    },
    {
        puesto: 3,
        nombre: "Estudiante Ejemplo 3",
        curso: "3.º medio TP",
        puntos: 880,
    },
    {
        puesto: 4,
        nombre: "Estudiante Ejemplo 4",
        curso: "4.º medio TP",
        puntos: 860,
    },
    {
        puesto: 5,
        nombre: "Estudiante Ejemplo 5",
        curso: "3.º medio TP",
        puntos: 810,
    },
    {
        puesto: 6,
        nombre: "Estudiante Ejemplo 6",
        curso: "4.º medio TP",
        puntos: 790,
    },
];
---

<Layout title="Ranking | Ranking TP">
    <section class="hero">
        <div class="contenedor">
            <span class="etiqueta">🏆 Resultados académicos</span>
            <h1>Ranking de Programación</h1>
            <p>Consulta los puntajes de demostración de 3.º y 4.º medio TP.</p>
        </div>
    </section>

    <section class="seccion">
        <div class="contenedor">
            <h2 class="titulo-seccion">Tabla de posiciones</h2>
            <p class="texto-suave">
                Periodo: demostración. Estos resultados no son oficiales.
            </p>

            <div class="tabla-contenedor">
                <table>
                    <thead>
                        <tr>
                            <th>Puesto</th>
                            <th>Estudiante</th>
                            <th>Curso</th>
                            <th>Puntaje</th>
                        </tr>
                    </thead>

                    <tbody>
                        {
                            estudiantes.map((estudiante) => (
                                <tr>
                                    <td>
                                        {estudiante.puesto === 1
                                            ? "🥇"
                                            : estudiante.puesto === 2
                                              ? "🥈"
                                              : estudiante.puesto === 3
                                                ? "🥉"
                                                : estudiante.puesto}
                                    </td>
                                    <td>{estudiante.nombre}</td>
                                    <td>{estudiante.curso}</td>
                                    <td>
                                        <strong>
                                            {estudiante.puntos} pts.
                                        </strong>
                                    </td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            <div class="panel" style="margin-top: 24px;">
                <h2>¿Cómo se calcula el ranking?</h2>
                <p>
                    El establecimiento debe definir los criterios de evaluación,
                    la asignación de puntajes y las fechas de publicación.
                </p>
            </div>
        </div>
    </section>
</Layout>
