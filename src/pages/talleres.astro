---
import Layout from "../layouts/Layout.astro";
import TarjetaTaller from "../components/TarjetaTaller.astro";
---

<Layout
    title="Asignaturas | Ranking TP"
    description="Áreas de aprendizaje de la especialidad TP."
>


    <section class="pagina">

        <div class="contenedor">

            <span class="etiqueta">
                ESPECIALIDAD TP
            </span>

            <h1>
                Áreas de aprendizaje
            </h1>

            <p class="texto-intro">
                Conoce las principales asignaturas técnicas
                consideradas dentro del seguimiento académico.
            </p>


            <div class="rejilla">

                <TarjetaTaller
                    nombre="Desarrollo Web"
                    descripcion="Creación de sitios web, estructura, diseño y estilos mediante tecnologías web."
                    icono="🌐"
                />


                <TarjetaTaller
                    nombre="Programación y Algoritmos"
                    descripcion="Desarrollo de algoritmos, lógica de programación y resolución de problemas."
                    icono="💻"
                />


                <TarjetaTaller
                    nombre="Diseño de Base de Datos"
                    descripcion="Modelamiento, organización y almacenamiento de información."
                    icono="🗄️"
                />


                <TarjetaTaller
                    nombre="Infraestructura TI"
                    descripcion="Redes, servidores, hardware y sistemas operativos."
                    icono="🖥️"
                />

            </div>

        </div>

    </section>


</Layout>