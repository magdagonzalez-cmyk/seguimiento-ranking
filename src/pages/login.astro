---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="Iniciar sesión | TP Ranking"
    description="Inicio de sesión para estudiantes de TP Ranking."
>

    <main class="login-pagina">

        <section class="login-contenedor">

            <!-- PARTE IZQUIERDA -->
            <div class="login-presentacion">

                <div class="login-logo">
                    🏆
                </div>

                <span class="login-etiqueta">
                    TP RANKING
                </span>

                <h1>
                    Bienvenido
                </h1>

                <p>
                    Inicia sesión para consultar tu información
                    académica, ranking, notas y asistencia.
                </p>

                <div class="login-info">
                    <div>
                        🔒
                        <span>
                            Acceso seguro
                        </span>
                    </div>

                    <div>
                        👨‍🎓
                        <span>
                            Información personal
                        </span>
                    </div>
                </div>

            </div>


            <!-- FORMULARIO -->
            <div class="login-formulario">

                <div class="login-titulo">

                    <span>
                        ACCESO ESTUDIANTE
                    </span>

                    <h2>
                        Iniciar sesión
                    </h2>

                    <p>
                        Utiliza tus credenciales de estudiante.
                    </p>

                </div>


                <form
                    action="/api/login"
                    method="POST"
                    class="form-login"
                >

                    <div class="campo-login">

                        <label for="rut">
                            RUT
                        </label>

                        <input
                            type="text"
                            id="rut"
                            name="rut"
                            placeholder="Ej: 12.345.678-9"
                            autocomplete="username"
                            required
                        />

                    </div>


                    <div class="campo-login">

                        <label for="password">
                            Contraseña
                        </label>

                        <input
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Ingresa tu contraseña"
                            autocomplete="current-password"
                            required
                        />

                    </div>


                    <button
                        type="submit"
                        class="boton-login"
                    >
                        Iniciar sesión
                        <span>→</span>
                    </button>

                </form>


                <div class="login-aviso">

                    <span>🔐</span>

                    <p>
                        Tus datos de acceso son personales.
                        No compartas tu contraseña con otras personas.
                    </p>

                </div>

            </div>

        </section>

    </main>

</Layout>