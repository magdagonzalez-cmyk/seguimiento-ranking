---
import Layout from "../layouts/Layout.astro";

const año = 2026;

const meses = [
    "Enero",
    "Febrero",
    "Marzo",
    "Abril",
    "Mayo",
    "Junio",
    "Julio",
    "Agosto",
    "Septiembre",
    "Octubre",
    "Noviembre",
    "Diciembre"
];

const diasSemana = [
    "LUNES",
    "MARTES",
    "MIÉRCOLES",
    "JUEVES",
    "VIERNES"
];

/*
    Feriados nacionales de Chile 2026.

    Los sábados y domingos tampoco aparecen
    en el calendario de asistencia.
*/
const feriados = [
    "2026-01-01",
    "2026-04-03",
    "2026-04-04",
    "2026-05-01",
    "2026-05-21",
    "2026-06-21",
    "2026-06-29",
    "2026-07-16",
    "2026-08-15",
    "2026-09-18",
    "2026-09-19",
    "2026-10-12",
    "2026-10-31",
    "2026-11-01",
    "2026-12-08",
    "2026-12-25"
];

/*
    Ejemplos de asistencia.

    🔴 Ausente
    🟡 Parcial
    🟢 Presente

    Puedes cambiar estas fechas por las reales
    del estudiante.
*/
const ausencias = [
    "2026-03-06",
    "2026-03-17",
    "2026-05-08",
    "2026-08-14",
    "2026-10-07",
    "2026-11-06"
];

const parciales = [
    "2026-03-04",
    "2026-03-11",
    "2026-04-09",
    "2026-06-04",
    "2026-08-07",
    "2026-10-06",
    "2026-11-04"
];

function fechaISO(fecha: Date) {
    const mes = String(fecha.getMonth() + 1).padStart(2, "0");
    const dia = String(fecha.getDate()).padStart(2, "0");

    return `${fecha.getFullYear()}-${mes}-${dia}`;
}

function obtenerEstado(fecha: Date) {
    const fechaTexto = fechaISO(fecha);

    if (ausencias.includes(fechaTexto)) {
        return "ausente";
    }

    if (parciales.includes(fechaTexto)) {
        return "parcial";
    }

    return "presente";
}

/*
    Obtiene los días del mes.

    Solamente:
    - lunes
    - martes
    - miércoles
    - jueves
    - viernes

    Se eliminan:
    - sábados
    - domingos
    - feriados
*/
function obtenerDiasMes(numeroMes: number) {
    const dias = [];

    const ultimoDia = new Date(
        año,
        numeroMes + 1,
        0
    ).getDate();

    for (let dia = 1; dia <= ultimoDia; dia++) {
        const fecha = new Date(
            año,
            numeroMes,
            dia
        );

        const diaSemana = fecha.getDay();

        // Domingo y sábado
        if (diaSemana === 0 || diaSemana === 6) {
            continue;
        }

        const fechaTexto = fechaISO(fecha);

        // Feriado
        if (feriados.includes(fechaTexto)) {
            continue;
        }

        dias.push({
            numero: dia,
            fecha: fechaTexto,
            estado: obtenerEstado(fecha),
            diaSemana: diaSemana
        });
    }

    return dias;
}
---

<Layout
    title="Mi información | TP Ranking"
    description="Información académica y asistencia del estudiante."
>
    <main class="mi-informacion">

        <!-- CABECERA -->
        <section class="perfil-principal">

            <div class="perfil-identidad">

                <div class="avatar-grande">
                    JP
                </div>

                <div>
                    <span class="etiqueta-perfil">
                        🔐 INFORMACIÓN PRIVADA
                    </span>

                    <h1>
                        Juan Pérez
                    </h1>

                    <p>
                        3.º Medio TP
                    </p>
                </div>

            </div>

            <div class="perfil-decoracion">
                🏆
            </div>

        </section>


        <!-- RESUMEN -->
        <section class="resumen">

            <div class="resumen-card ranking-card">

                <span class="resumen-icono">
                    🏆
                </span>

                <div>
                    <span>MI POSICIÓN</span>
                    <strong>#4</strong>
                    <small>de 32 estudiantes</small>
                </div>

            </div>


            <div class="resumen-card promedio-card">

                <span class="resumen-icono">
                    📊
                </span>

                <div>
                    <span>MI PROMEDIO</span>
                    <strong>6,0</strong>
                    <small>promedio general</small>
                </div>

            </div>


            <div class="resumen-card anotaciones-card">

                <span class="resumen-icono">
                    📝
                </span>

                <div>
                    <span>ANOTACIONES</span>
                    <strong>1</strong>
                    <small>registrada</small>
                </div>

            </div>

        </section>


        <!-- NOTAS -->
        <section class="informacion-card">

            <div class="titulo-card">

                <div>
                    <span>RENDIMIENTO</span>
                    <h2>Mis notas</h2>
                </div>

                <span class="titulo-icono">
                    📚
                </span>

            </div>


            <div class="notas-lista">

                <div class="nota-fila">
                    <span>Infraestructura TI</span>
                    <strong>6,1</strong>
                </div>

                <div class="nota-fila">
                    <span>Diseño de Base de Datos</span>
                    <strong>5,8</strong>
                </div>

                <div class="nota-fila">
                    <span>Programación y Algoritmos</span>
                    <strong>6,0</strong>
                </div>

                <div class="nota-fila">
                    <span>Desarrollo Web</span>
                    <strong>6,1</strong>
                </div>

            </div>

        </section>


        <!-- ANOTACIONES -->
        <section class="anotacion-destacada">

            <div class="anotacion-icono">
                📝
            </div>

            <div>

                <span>MI ANOTACIÓN</span>

                <h2>
                    Registro académico
                </h2>

                <p>
                    Atrasos e inasistencias registrados durante
                    el período académico.
                </p>

            </div>

        </section>


        <!-- ASISTENCIA -->
        <section class="asistencia-seccion">

            <div class="asistencia-titulo">

                <div>

                    <span>ASISTENCIA</span>

                    <h2>
                        Mi asistencia
                    </h2>

                    <p>
                        Consulta tu asistencia durante todo el año.
                        Los fines de semana y feriados no se contabilizan.
                    </p>

                </div>

                <div class="año">
                    {año}
                </div>

            </div>


            <!-- LEYENDA -->
            <div class="leyenda">

                <div>
                    <span class="punto verde"></span>
                    Presente
                </div>

                <div>
                    <span class="punto amarillo"></span>
                    Parcial
                </div>

                <div>
                    <span class="punto rojo"></span>
                    Ausente
                </div>

            </div>


            <!--
                CONTROLES CSS

                No usamos JavaScript.
                Cada radio representa un mes.
            -->

            {
                meses.map((_, indice) => (
                    <input
                        type="radio"
                        name="mes"
                        id={`mes-${indice + 1}`}
                        class="control-mes"
                        checked={indice === 0}
                    />
                ))
            }


            <!-- CALENDARIO -->
            <div class="calendario">

                <div class="calendario-ventana">

                    <div class="calendario-track">

                        {
                            meses.map((nombreMes, numeroMes) => {

                                const dias = obtenerDiasMes(numeroMes);

                                return (
                                    <section class="mes">

                                        <div class="mes-cabecera">

                                            <div>

                                                <span>
                                                    CALENDARIO DE ASISTENCIA
                                                </span>

                                                <h3>
                                                    {nombreMes}
                                                </h3>

                                            </div>

                                            <strong>
                                                {año}
                                            </strong>

                                        </div>


                                        <!-- DÍAS DE LA SEMANA -->
                                        <div class="dias-semana">

                                            {
                                                diasSemana.map((dia) => (
                                                    <div>
                                                        {dia}
                                                    </div>
                                                ))
                                            }

                                        </div>


                                        <!-- DÍAS -->
                                        <div class="dias-grid">

                                            {
                                                dias.map((dia) => (

                                                    <div
                                                        class={`dia-asistencia ${dia.estado}`}
                                                    >

                                                        <strong>
                                                            {dia.numero}
                                                        </strong>

                                                        <span class="estado-icono">
                                                            {
                                                                dia.estado === "presente"
                                                                    ? "🟢"
                                                                    : dia.estado === "parcial"
                                                                        ? "🟡"
                                                                        : "🔴"
                                                            }
                                                        </span>

                                                        <span class="estado-texto">
                                                            {
                                                                dia.estado === "presente"
                                                                    ? "Presente"
                                                                    : dia.estado === "parcial"
                                                                        ? "Parcial"
                                                                        : "Ausente"
                                                            }
                                                        </span>

                                                    </div>

                                                ))
                                            }

                                        </div>

                                    </section>
                                );

                            })
                        }

                    </div>

                </div>


                <!-- FLECHAS -->
                <div class="flechas">

                    {
                        meses.map((_, indice) => {

                            const anterior =
                                indice === 0
                                    ? 12
                                    : indice;

                            const siguiente =
                                indice === 11
                                    ? 1
                                    : indice + 2;

                            return (

                                <div
                                    class={`controles-mes controles-mes-${indice + 1}`}
                                >

                                    <label
                                        for={`mes-${anterior}`}
                                        class="flecha flecha-izquierda"
                                        aria-label="Mes anterior"
                                    >
                                        ←
                                    </label>


                                    <span>
                                        {meses[indice]}
                                    </span>


                                    <label
                                        for={`mes-${siguiente}`}
                                        class="flecha flecha-derecha"
                                        aria-label="Mes siguiente"
                                    >
                                        →
                                    </label>

                                </div>

                            );

                        })
                    }

                </div>

            </div>


            <!-- AVISO -->
            <div class="aviso-asistencia">

                <span>
                    💡
                </span>

                <p>

                    <strong>
                        ¿Qué significa cada color?
                    </strong>

                    El color verde indica que estuviste presente en
                    todas las clases registradas. El amarillo significa
                    que hubo asistencia parcial o que algún profesor
                    no registró la lista completa. El rojo indica
                    ausencia.

                </p>

            </div>

        </section>

    </main>
</Layout>


<style>

/* =========================================================
   CONTENEDOR GENERAL
========================================================= */

.mi-informacion {
    width: min(1150px, 92%);
    margin: 0 auto;
    padding: 45px 0 70px;
}


/* =========================================================
   PERFIL
========================================================= */

.perfil-principal {
    background: linear-gradient(
        135deg,
        #27456c,
        #47748b
    );

    border-radius: 26px;
    padding: 30px 35px;

    display: flex;
    justify-content: space-between;
    align-items: center;

    color: white;

    box-shadow: 0 15px 35px rgba(39, 69, 108, 0.18);

    margin-bottom: 25px;
}

.perfil-identidad {
    display: flex;
    align-items: center;
    gap: 20px;
}

.avatar-grande {
    width: 78px;
    height: 78px;

    border-radius: 50%;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #f7a088;

    color: #27456c;

    font-size: 25px;
    font-weight: 900;

    border: 5px solid rgba(255,255,255,0.3);
}

.etiqueta-perfil {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;

    opacity: 0.85;
}

.perfil-principal h1 {
    margin: 6px 0 3px;
    font-size: 30px;
}

.perfil-principal p {
    margin: 0;
    opacity: 0.85;
}

.perfil-decoracion {
    font-size: 55px;
}


/* =========================================================
   RESUMEN
========================================================= */

.resumen {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;

    margin-bottom: 25px;
}

.resumen-card {
    padding: 23px;

    border-radius: 20px;

    display: flex;
    align-items: center;
    gap: 17px;

    background: white;

    box-shadow: 0 10px 28px rgba(39, 69, 108, 0.10);

    border: 2px solid #99bfd5;
}

.resumen-icono {
    width: 52px;
    height: 52px;

    display: flex;
    align-items: center;
