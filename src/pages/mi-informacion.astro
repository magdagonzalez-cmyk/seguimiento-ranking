.mes-cabecera strong {
    background: #eccca6;

    color: #27456c;

    padding: 9px 14px;

    border-radius: 11px;

    font-size: 14px;
}


/* =========================================================
   DÍAS DE LA SEMANA
========================================================= */

.dias-semana {
    display: grid;

    grid-template-columns: repeat(5, 1fr);

    gap: 8px;

    margin-bottom: 8px;
}

.dias-semana div {
    text-align: center;

    background: #27456c;

    color: white;

    padding: 10px 5px;

    border-radius: 9px;

    font-size: 10px;

    font-weight: 900;
}


/* =========================================================
   DÍAS
========================================================= */

.dias-grid {
    display: grid;

    grid-template-columns: repeat(5, 1fr);

    gap: 8px;
}

.dia-asistencia {
    min-height: 68px;

    padding: 10px;

    border-radius: 12px;

    display: flex;

    flex-direction: column;

    justify-content: center;

    align-items: center;

    text-align: center;

    border: 2px solid transparent;

    transition:
        transform 0.2s ease,
        box-shadow 0.2s ease;
}

.dia-asistencia:hover {
    transform: translateY(-3px);

    box-shadow: 0 7px 15px rgba(39, 69, 108, 0.12);
}

.dia-asistencia strong {
    font-size: 20px;

    color: #27456c;
}

.estado-icono {
    font-size: 14px;

    margin-top: 2px;
}

.estado-texto {
    font-size: 9px;

    font-weight: 800;

    margin-top: 2px;
}


/* PRESENTE */

.dia-asistencia.presente {
    background: #e6f7ef;

    border-color: #8bd7b1;
}

.dia-asistencia.presente .estado-texto {
    color: #299363;
}


/* PARCIAL */

.dia-asistencia.parcial {
    background: #fff6d9;

    border-color: #e9ce6d;
}

.dia-asistencia.parcial .estado-texto {
    color: #a57c10;
}


/* AUSENTE */

.dia-asistencia.ausente {
    background: #ffe7eb;

    border-color: #ef9ca8;
}

.dia-asistencia.ausente .estado-texto {
    color: #c54252;
}


/* =========================================================
   FLECHAS
========================================================= */

.flechas {
    margin-top: 18px;

    position: relative;

    min-height: 52px;

    display: flex;

    align-items: center;

    justify-content: center;
}

.controles-mes {
    display: none;

    width: 100%;

    align-items: center;

    justify-content: space-between;
}

.controles-mes span {
    background: #47748b;

    color: white;

    padding: 9px 20px;

    border-radius: 12px;

    font-size: 13px;

    font-weight: 800;
}

.flecha {
    width: 43px;
    height: 43px;

    border-radius: 50%;

    background: #e95c6c;

    color: white;

    display: flex;

    align-items: center;

    justify-content: center;

    font-size: 24px;

    font-weight: bold;

    cursor: pointer;

    transition:
        transform 0.2s ease,
        background 0.2s ease;
}

.flecha:hover {
    transform: scale(1.08);

    background: #27456c;
}


/* =========================================================
   CAMBIO DE MES
========================================================= */

#mes-1:checked ~ .calendario .calendario-track {
    transform: translateX(0%);
}

#mes-2:checked ~ .calendario .calendario-track {
    transform: translateX(-8.333333%);
}

#mes-3:checked ~ .calendario .calendario-track {
    transform: translateX(-16.666666%);
}

#mes-4:checked ~ .calendario .calendario-track {
    transform: translateX(-25%);
}

#mes-5:checked ~ .calendario .calendario-track {
    transform: translateX(-33.333333%);
}

#mes-6:checked ~ .calendario .calendario-track {
    transform: translateX(-41.666666%);
}

#mes-7:checked ~ .calendario .calendario-track {
    transform: translateX(-50%);
}

#mes-8:checked ~ .calendario .calendario-track {
    transform: translateX(-58.333333%);
}

#mes-9:checked ~ .calendario .calendario-track {
    transform: translateX(-66.666666%);
}

#mes-10:checked ~ .calendario .calendario-track {
    transform: translateX(-75%);
}

#mes-11:checked ~ .calendario .calendario-track {
    transform: translateX(-83.333333%);
}

#mes-12:checked ~ .calendario .calendario-track {
    transform: translateX(-91.666666%);
}


/* =========================================================
   MOSTRAR LAS FLECHAS DEL MES ACTUAL
========================================================= */

#mes-1:checked ~ .calendario .controles-mes-1,
#mes-2:checked ~ .calendario .controles-mes-2,
#mes-3:checked ~ .calendario .controles-mes-3,
#mes-4:checked ~ .calendario .controles-mes-4,
#mes-5:checked ~ .calendario .controles-mes-5,
#mes-6:checked ~ .calendario .controles-mes-6,
#mes-7:checked ~ .calendario .controles-mes-7,
#mes-8:checked ~ .calendario .controles-mes-8,
