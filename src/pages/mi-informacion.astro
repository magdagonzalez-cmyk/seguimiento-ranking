    opacity: 0;

    pointer-events: none;
}


/* =========================================================
   CALENDARIO
========================================================= */

.calendario {
    width: 100%;
}

.calendario-ventana {
    width: 100%;

    overflow: hidden;

    border-radius: 22px;
}

.calendario-track {
    display: flex;

    width: 1200%;

    transition:
        transform 0.65s cubic-bezier(0.77, 0, 0.18, 1);
}

.mes {
    flex: 0 0 8.333333%;

    width: 8.333333%;

    padding: 22px;

    box-sizing: border-box;

    background:
        linear-gradient(
            135deg,
            #f4f8fa,
            #ffffff
        );

    border: 2px solid #99bfd5;

    border-radius: 22px;
}


/* =========================================================
   CABECERA DEL MES
========================================================= */

.mes-cabecera {
    display: flex;

    align-items: center;

    justify-content: space-between;

    margin-bottom: 20px;
}

.mes-cabecera span {
    color: #e95c6c;

    font-size: 10px;

