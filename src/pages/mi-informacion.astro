    margin-bottom: 0;
}

.año {
    background: #27456c;

    color: white;

    padding: 12px 20px;

    border-radius: 13px;

    font-weight: 900;
}


/* =========================================================
   LEYENDA
========================================================= */

.leyenda {
    display: flex;
    gap: 25px;

    padding: 15px 0 20px;

