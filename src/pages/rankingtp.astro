---
import Layout from "../layouts/Layout.astro";
---

<Layout
    title="TP Ranking"
    description="Sistema de ranking para estudiantes TP."
>

    <main>

        <section class="hero">

            <div class="hero-contenido">

                <span class="etiqueta">
                    🏆 TP RANKING
                </span>

                <h1>
                    Sistema de Ranking
                    <br />
                    Estudiantes TP
                </h1>

                <p>
                    Consulta el ranking de los estudiantes de
                    3.º y 4.º Medio TP y accede a tu información
                    académica personal.
                </p>

                <div class="hero-botones">

                    <a
                        href="/ranking"
                        class="boton"
                    >
                        Ver ranking
                    </a>

                    <a
                        href="/mi-informacion"
                        class="boton boton-secundario"
                    >
                        Mi información
                    </a>

                </div>

            </div>

        </section>

    </main>

</Layout>